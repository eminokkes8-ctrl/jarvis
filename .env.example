# Anthropic Claude - konusma zekasi (chat)
ANTHROPIC_API_KEY=

# OpenAI - ses tanima (Whisper) ve seslendirme (TTS) icin
OPENAI_API_KEY=

# Istege bagli
PORT=3000
CLAUDE_MODEL=claude-sonnet-5
TTS_VOICE=alloy

# Web'de arastirip ogrenme ozelligi (Anthropic web_search araci). Kapatmak icin "false" yapin.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=3
