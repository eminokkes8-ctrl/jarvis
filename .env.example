# LLM saglayicisi: "gemini" (Google AI Studio, ucretsiz ama API anahtari ister),
# "openai" (GPT, ucretli, OPENAI_API_KEY ister), "anthropic" (Claude, ucretli)
# ya da "ollama" (bilgisayarinda calisan, API anahtari GEREKTIRMEYEN yerel
# model). BOS BIRAKIRSAN: GEMINI_API_KEY tanimliysa Gemini, degilse otomatik
# olarak Ollama kullanilir - yani hicbir API anahtari girmeden de calisir
# (Ollama'nin bilgisayarinda kurulu ve acik olmasi yeterli).
LLM_PROVIDER=

# Google Gemini - aistudio.google.com/apikey adresinden UCRETSIZ alinir, kredi karti gerekmez.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Ollama - API ANAHTARI GEREKTIRMEZ, bilgisayarinda calisan Ollama uygulamasini
# kullanir (ollama.com adresinden indirilir). GEMINI_API_KEY bos birakilirsa
# otomatik olarak bu kullanilir. Varsayilan model Hermes 3 (Nous Research) -
# fonksiyon-cagirma/agent gorevlerinde llama3.1'e gore daha guclu. Kullanmadan
# once bir kere indirmen gerekir: ollama run hermes3
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=hermes3

# Anthropic Claude - SADECE LLM_PROVIDER=anthropic ise gerekir (ucretli).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Hafiza cikarma / kendini gelistirme gibi GORUNMEZ arka plan cagrilari (Claude
# kullanilirken) her zaman bu ucuz modeli kullanir.
CLAUDE_BACKGROUND_MODEL=claude-haiku-4-5-20251001

# OpenAI - "OpenAI" ses motoru SECILIRSE (Whisper+TTS) YA DA LLM_PROVIDER=openai
# ISE (sohbet) gerekir - ikisi de ucretlidir (tarayici sesi modu ucretsizdir).
OPENAI_API_KEY=
# Sadece LLM_PROVIDER=openai ise kullanilir (varsayilan: gpt-4o-mini, ucuz+hizli).
OPENAI_MODEL=gpt-4o-mini

# Istege bagli
PORT=3000
# Sesli cevaplarin token (ve maliyet) ust siniri.
CHAT_MAX_TOKENS=400
TTS_VOICE=alloy

# Web arama SADECE Claude (anthropic) saglayicisinda desteklenir, ekstra ucret getirir.
ENABLE_WEB_SEARCH=false
WEB_SEARCH_MAX_USES=3
