# LLM saglayicisi: "gemini" (varsayilan, UCRETSIZ - Google AI Studio) ya da
# "anthropic" (Claude, ucretli). Baska bir sey yazarsan gemini varsayilan kalir.
LLM_PROVIDER=gemini

# Google Gemini - aistudio.google.com/apikey adresinden UCRETSIZ alinir, kredi karti gerekmez.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude - SADECE LLM_PROVIDER=anthropic ise gerekir (ucretli).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Hafiza cikarma / kendini gelistirme gibi GORUNMEZ arka plan cagrilari (Claude
# kullanilirken) her zaman bu ucuz modeli kullanir.
CLAUDE_BACKGROUND_MODEL=claude-haiku-4-5-20251001

# OpenAI - SADECE "OpenAI" ses motoru secilirse gerekir (tarayici modu ucretsizdir)
OPENAI_API_KEY=

# Istege bagli
PORT=3000
# Sesli cevaplarin token (ve maliyet) ust siniri.
CHAT_MAX_TOKENS=400
TTS_VOICE=alloy

# Web arama SADECE Claude (anthropic) saglayicisinda desteklenir, ekstra ucret getirir.
ENABLE_WEB_SEARCH=false
WEB_SEARCH_MAX_USES=3
