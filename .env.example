# Anthropic Claude - konusma zekasi (chat)
ANTHROPIC_API_KEY=

# OpenAI - SADECE "OpenAI" ses modu secilirse gerekir (tarayici modu ucretsizdir)
OPENAI_API_KEY=

# Istege bagli
PORT=3000

# Maliyet kontrolu: varsayilan olarak UCUZ bir model kullanilir (Haiku). Daha iyi
# cevap kalitesi icin claude-sonnet-5 yapabilirsin ama bu daha pahalidir.
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Hafiza cikarma / kendini gelistirme gibi GORUNMEZ arka plan cagrilari (kullanicinin
# gormedigi, her turda sessizce calisan istekler) her zaman bu ucuz modeli kullanir.
CLAUDE_BACKGROUND_MODEL=claude-haiku-4-5-20251001
# Sesli cevaplarin token (ve maliyet) ust siniri.
CHAT_MAX_TOKENS=400

TTS_VOICE=alloy

# Web'de arastirip ogrenme ozelligi (Anthropic web_search araci). Hem token hem
# arama basina EKSTRA ucret getirir, bu yuzden varsayilan KAPALI. Acmak icin "true" yapin.
ENABLE_WEB_SEARCH=false
WEB_SEARCH_MAX_USES=3
